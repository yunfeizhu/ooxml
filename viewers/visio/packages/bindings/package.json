{
	"name": "@christophervr/visio-viewer-bindings",
	"version": "0.0.0",
	"private": true,
	"description": "Private native framework lifecycle adapters for the shared Visio viewer",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./vanilla": "./src/vanilla.ts",
		"./react": "./src/react.ts",
		"./vue": "./src/vue.ts",
		"./angular": "./src/angular.ts",
		"./solid": "./src/solid.tsx",
		"./svelte": {
			"svelte": "./src/VisioViewer.svelte",
			"default": "./src/VisioViewer.svelte"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig tsconfig.svelte.json",
		"test": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts",
		"check": "bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@angular/common": "^22.2.1",
		"@angular/compiler": "^22.2.1",
		"@angular/core": "^22.2.1",
		"@angular/platform-browser": "^22.2.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vue/server-renderer": "^3.5.43",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rxjs": "^7.8.2",
		"solid-js": "^1.9.16",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.3.3",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^5.0.3",
		"vue": "^3.5.43"
	}
}

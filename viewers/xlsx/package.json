{
	"name": "xlsx-viewer-workspace",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:local": "node scripts/local-core-tsconfig.mjs && tsc --noEmit -p tsconfig.local.json",
		"test": "vitest run",
		"build:packages": "node scripts/build-packages.mjs",
		"pack:smoke": "node scripts/pack-smoke.mjs",
		"build": "vite build ../../demos/xlsx/demo-vanilla --config vite.config.ts",
		"demo": "vite ../../demos/xlsx/demo-vanilla --config vite.config.ts --host 127.0.0.1",
		"test:browser": "playwright test",
		"check:shared": "node scripts/check-shared.mjs",
		"check:published": "node scripts/check-published-refs.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@angular/common": "^22.2.1",
		"@angular/compiler": "^22.2.1",
		"@angular/core": "^22.2.1",
		"@angular/platform-browser": "^22.2.1",
		"@xmldom/xmldom": "^0.9.12",
		"jszip": "^3.10.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rxjs": "^7.8.2",
		"svelte": "^5.57.2",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"rollup": "^4.64.0",
		"rollup-plugin-dts": "^6.5.1",
		"solid-js": "^1.9.16",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	}
}

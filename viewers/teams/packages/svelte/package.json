{
	"name": "openteams-svelte-viewer",
	"version": "0.1.8",
	"description": "Svelte 5 component and store for OpenTeams, the open-source bring-your-own-server team workspace. Self-contained: includes the <teams-app> UI.",
	"keywords": [
		"chat",
		"collaboration",
		"openteams",
		"svelte",
		"team-workspace",
		"webrtc",
		"yjs"
	],
	"homepage": "https://christophervr.github.io/ooxml/teams/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/teams/packages/svelte"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/runtime.js",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/Teams.svelte",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/Teams.svelte",
			"default": "./dist/Teams.svelte"
		},
		"./Teams.svelte": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/Teams.svelte",
			"default": "./dist/Teams.svelte"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"lit": "^3.3.3",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"devDependencies": {
		"svelte": "^5.57.2"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}

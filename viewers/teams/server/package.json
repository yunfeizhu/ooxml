	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/teams/server"
	},
	"bin": {
		"openteams-server": "bin.mjs"
	},
	"files": [

		"team-workspace",
		"webrtc",
		"websocket",
		"y-websocket",
		"yjs"
	],
	"homepage": "https://christophervr.github.io/ooxml/teams/server",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
